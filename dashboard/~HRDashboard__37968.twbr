      <column caption='Business Travel' datatype='string' name='[BusinessTravel]' role='dimension' type='nominal' />
      <column caption='Total Employment Status' datatype='integer' name='[Calculation_1625518001113382914]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([EmployeeID])' />
      </column>
      <column caption='HR Department' datatype='boolean' name='[Calculation_1625518001122816005]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Department] = &quot;Human Resources&quot;' />
      </column>
      <column caption='Sales Department' datatype='boolean' name='[Calculation_1625518001123254278]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Department] = &quot;Sales&quot;' />
      </column>
      <column caption='Tech Department' datatype='boolean' name='[Calculation_1625518001123356679]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Department] = &quot;Technology&quot;' />
      </column>
      <column caption='Active Employee' datatype='integer' name='[Calculation_3012908158621868033]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Attrition] = &quot;No&quot; THEN 1 ELSE 0 END&#13;&#10;)' />
      </column>
      <column caption='Inactive Employee' datatype='integer' name='[Calculation_3012908158623944706]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Attrition] = &quot;Yes&quot; THEN 1 ELSE 0 END&#13;&#10;)' />
      </column>
      <column caption='Attrition Rate' datatype='real' default-format='p0.00%' name='[Calculation_3012908158627328003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3012908158864125962]) / COUNT([EmployeeID])' />
      </column>
      <column caption='Years' datatype='integer' name='[Calculation_3012908158632886276]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR([HireDate])' />
      </column>
      <column caption='Dynamic Employment Status' datatype='string' name='[Calculation_3012908158637682693]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF YEAR([HireDate]) + [YearsAtCompany] &gt;= 2022 THEN &quot;Active&quot;&#13;&#10;ELSE &quot;Inactive&quot;&#13;&#10;END' />
      </column>
      <column caption='Active Employment Status ' datatype='integer' name='[Calculation_3012908158638342150]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_3012908158637682693] = &quot;Active&quot; THEN 1 END' />
      </column>
      <column caption='Inactive Employment Status' datatype='integer' name='[Calculation_3012908158638936071]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_3012908158637682693] = &quot;Inactive&quot; THEN 1 END' />
      </column>
      <column caption='Youngest Employee KPI' datatype='integer' name='[Calculation_3012908158840123400]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN([Age])' />
      </column>
      <column caption='Oldest Employee KPI' datatype='integer' name='[Calculation_3012908158841053193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([Age])' />
      </column>
      <column caption='Attrition Count' datatype='integer' name='[Calculation_3012908158864125962]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If [Attrition] = &quot;Yes&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Average Age' datatype='real' name='[Calculation_3012908158874447884]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Age])' />
      </column>
      <column caption='Average Years At Company' datatype='real' name='[Calculation_3012908158877007885]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([YearsAtCompany])' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_3012908158877888526]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] &lt; 20 THEN &quot;&lt;20&quot;&#13;&#10;ELSEIF [Age] &gt;= 20 AND [Age] &lt;= 29 THEN &quot;20-29&quot;&#13;&#10;ELSEIF [Age] &gt;= 30 AND [Age] &lt;= 39 THEN &quot;30-39&quot;&#13;&#10;ELSEIF [Age] &gt;= 40 AND [Age] &lt;= 49 THEN &quot;40-49&quot;&#13;&#10;ELSE &quot;50+&quot;&#13;&#10;END' />
