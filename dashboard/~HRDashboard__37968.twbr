          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='16'>Employee Status Over Time</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Employee+' name='federated.02rej811cr6ep11grbs4509kaaso' />
          </datasources>
          <datasource-dependencies datasource='federated.02rej811cr6ep11grbs4509kaaso'>
            <column caption='Total Employment Status' datatype='integer' name='[Calculation_1625518001113382914]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([EmployeeID])' />
            </column>
            <column caption='Years' datatype='integer' name='[Calculation_3012908158632886276]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='YEAR([HireDate])' />
            </column>
            <column caption='Dynamic Employment Status' datatype='string' name='[Calculation_3012908158637682693]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF YEAR([HireDate]) + [YearsAtCompany] &gt;= 2022 THEN &quot;Active&quot;&#13;&#10;ELSE &quot;Inactive&quot;&#13;&#10;END' />
            </column>
            <column caption='Active Employment Status ' datatype='integer' name='[Calculation_3012908158638342150]' role='measure' type='quantitative'>
