    <worksheet name='2-KPIs'>
      <table>
        <view>
          <datasources>
            <datasource caption='Employee+' name='federated.02rej811cr6ep11grbs4509kaaso' />
          </datasources>
          <datasource-dependencies datasource='federated.02rej811cr6ep11grbs4509kaaso'>
            <column datatype='integer' name='[Age]' role='measure' type='quantitative' />
            <column caption='Youngest Employee KPI' datatype='integer' name='[Calculation_3012908158840123400]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN([Age])' />
